# ---------------------------------------------------------------------------
# Konfigurasi FASTSAMBO — dashboard monitoring bilman & cash-in ULP Samboja
#
# Salin berkas ini menjadi .env.local untuk pengembangan lokal, dan salin
# isinya ke Vercel > Project Settings > Environment Variables untuk produksi.
#
# Bila kedua variabel di bawah TIDAK diisi, dashboard tetap berjalan normal
# memakai data bawaan (lib/fallback/dataset.json, dibangun dari
# data/master/*.csv). Ini disengaja agar situs dapat langsung dideploy
# sebelum basis datanya siap, dan tidak ikut mati bila Supabase tak terjangkau.
# ---------------------------------------------------------------------------

# URL proyek Supabase — Dashboard Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://wtwzodjosrpozdsfcboc.supabase.co

# Kunci publik (anon / publishable). AMAN dipakai di sisi peramban karena
# seluruh akses tetap dibatasi Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# JANGAN pernah menaruh service_role key di berkas ini atau di variabel
# berawalan NEXT_PUBLIC_. Kunci itu melewati seluruh Row Level Security dan
# hanya boleh dipakai di sisi server yang tidak terekspos ke peramban.
